{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "-p",
        "3.13",
        "--from",
        "serena-agent@latest",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd"
      ],
      "enabled": true
    },
    "basic-memory": {
      "type": "local",
      "command": [
        "uvx",
        "basic-memory@latest",
        "mcp",
        "--project",
        "baluffo-memory"
      ],
      "enabled": true
    }
  }
}
