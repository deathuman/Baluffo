{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-agent-memory"],
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd"
      ],
      "enabled": true
    },
    "basic-memory": {
      "type": "local",
      "command": [
        "basic-memory",
        "mcp"
      ],
      "enabled": true
    }
  }
}
