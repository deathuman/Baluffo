# assert retired-row tombstones exist); runtime rewrites are committed.
!data/source-registry-tombstones.json.gz
data/local-user-data/
data/updater/
data/runtime/
data/fetch-report-history/
data/discovery-report-history/
!data/.gitkeep
!data/source-discovery-config.json
!data/contracts/
!data/contracts/*.json
!data/defaults/
!data/defaults/*.json

