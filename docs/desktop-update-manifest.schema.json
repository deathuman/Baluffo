{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baluffo Desktop Update Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "key_id",
    "channel",
    "version",
    "published_at",
    "min_desktop_updater_version",
    "min_supported_current_version",
    "data_schema_version",
    "rollback_allowed",
    "portable_artifact",
    "migration_plan",
    "signature"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "key_id": { "type": "string", "minLength": 1 },
    "channel": { "type": "string", "const": "stable" },
    "version": { "type": "string", "minLength": 1 },
    "published_at": { "type": "string", "minLength": 1 },
    "release_notes_url": { "type": "string" },
    "min_desktop_updater_version": { "type": "string", "minLength": 1 },
    "min_supported_current_version": { "type": "string", "minLength": 1 },
    "data_schema_version": { "type": "string", "minLength": 1 },
    "rollback_allowed": { "type": "boolean" },
    "portable_artifact": {
      "type": "object",
      "required": ["url", "sha256", "size_bytes"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "ship_recovery_artifact": {
      "type": "object",
      "required": ["url", "sha256", "size_bytes"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "migration_plan": {
      "type": "array",
      "items": { "type": "string" }
    },
    "signature": { "type": "string", "minLength": 1 }
  }
}
