{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baluffo source-sync snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "source",
    "active",
    "pending"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "active": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
