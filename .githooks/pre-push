#!/bin/sh
set -eu

need_gate=0
while read local_ref local_sha remote_ref remote_sha
do
    case "$remote_ref" in
        refs/heads/main)
            need_gate=1
            ;;
    esac
done

if [ "$need_gate" -eq 1 ]; then
    root="$(git rev-parse --show-toplevel)"
    cd "$root"
    echo "Running release-parity gates before pushing to main..."
    npm run lint:precommit:ci
    npm run test:py:extended
    npm run test:smoke
fi
