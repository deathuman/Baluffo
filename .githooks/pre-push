#!/bin/sh
set -eu

need_gate=0
while read local_ref local_sha remote_ref remote_sha
do
    case "$remote_ref" in
        refs/heads/main)
            need_gate=1
            ;;
    esac
done

if [ "$need_gate" -eq 1 ]; then
    root="$(git rev-parse --show-toplevel)"
    cd "$root"
    configured_hooks_path="$(git config --local --get core.hooksPath || true)"
    if [ "$configured_hooks_path" != ".githooks" ] && [ "$configured_hooks_path" != "./.githooks" ]; then
        echo "ERROR: git hooks are not configured for this repo." >&2
        echo "Run: npm run setup:hooks" >&2
        exit 1
    fi
    echo "Running release-parity gates before pushing to main..."
    npm run lint:precommit:ci
    npm run test:py:extended
    npm run test:smoke
fi
