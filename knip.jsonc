{
  "entry": [
    "frontend/jobs/index.js",
    "frontend/saved/index.js",
    "frontend/admin/index.js",
    "theme.js",
    "frontend-runtime-config.js"
  ],
  // hydrateDesktopVersionLabels is a @deprecated compatibility shim consumed
  // only by a unit test through the cache-busting importFresh helper, whose
  // dynamic import knip cannot statically resolve.
  "ignore": ["frontend/shared/app-version.js"],
  // `python` was listed here defensively, but knip resolves it from the
  // package.json scripts it actually reads, so the entry only produced a
  // "Remove from ignoreBinaries" hint on every run. `ruff` is still needed:
  // it is invoked by the pre-commit config, not by any script knip parses.
  "ignoreBinaries": ["ruff"],
  "project": [
    "frontend/**/*.js",
    "frontend/shared/config/admin-config.js",
    "frontend/shared/local-data/app-client.js",
    "frontend/shared/local-data/browser-client.js",
    "frontend/shared/local-data/desktop-client.js",
    "frontend/jobs/parsing-utils.js",
    "frontend/jobs/state.js",
    "frontend/saved/zip-utils.js",
    "probes/startup-probe.js",
    "tests/frontend/unit/**/*.mjs"
  ]
}
