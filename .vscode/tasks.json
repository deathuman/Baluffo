{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve static site only (8080)",
      "type": "shell",
      "command": "python -m http.server 8080 --directory .",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Serving HTTP on"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Stop static site only",
      "type": "shell",
      "command": "Get-CimInstance Win32_Process | Where-Object { $_.Name -match 'python(\\.exe)?' -and $_.CommandLine -match 'http\\.server 8080' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }",
      "problemMatcher": []
    },
    {
      "label": "Run jobs fetcher",
      "type": "shell",
      "command": "python -m src.jobs_fetcher",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run source discovery",
      "type": "shell",
      "command": "python src/source_discovery.py --mode dynamic",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Launch Baluffo",
      "type": "shell",
      "command": "python src/dev_admin_supervisor.py",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Stop Baluffo",
      "type": "shell",
      "command": "python src/dev_admin_supervisor.py stop",
      "problemMatcher": []
    },
    {
      "label": "Run validation",
      "type": "shell",
      "command": "node --check jobs.js; node --check admin.js; node --check saved.js; python -m unittest -v tests/test_jobs_fetcher.py tests/test_source_discovery.py tests/test_source_registry.py",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
