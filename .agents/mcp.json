{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "-p",
        "3.13",
        "--from",
        "serena-agent",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd"
      ]
    },
    "basic-memory": {
      "type": "stdio",
      "command": "basic-memory",
      "args": [
        "mcp",
        "--project",
        "baluffo-memory"
      ]
    }
  }
}
