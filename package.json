{
  "name": "baluffo-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": "25.8.0"
  },
  "scripts": {
    "dev:bridge": "npm run check:python-version && python src/dev_admin_supervisor.py",
    "dev:pipeline": "npm run check:python-version && python -m src.jobs.pipeline --force-refresh-all",
    "build": "npm run check:python-version && python scripts/orchestrator.py build",
    "prepare": "python scripts/install_git_hooks.py",
    "setup:hooks": "python scripts/install_git_hooks.py",
    "prepush:warm": "python scripts/run_pre_push_hook.py --warm-hooks",
    "prepush:full": "python scripts/run_pre_push_hook.py --full-ci",
    "test": "npm run test:unit && npm run test:smoke",
    "verify": "npm run check:python-version && python scripts/orchestrator.py verify",
    "check:python-version": "python scripts/check_python_version.py",
    "lint:precommit": "npm run lint:precommit:ci",
    "lint:precommit:changed": "python scripts/precommit_gate.py --mode changed",
    "lint:precommit:all": "python scripts/precommit_gate.py --mode all",
    "lint:precommit:ci": "python scripts/precommit_gate.py --mode all --exclude-root data",
    "lint:repo-guardrails": "python tools/repo_health/repo_guardrails.py",
    "test:refactor:changed": "python scripts/refactor_changed_gate.py",
    "release:preflight": "npm run lint:precommit && npm run test:py:extended && npm run test:frontend:unit && npm run test:frontend:packaged && npm run test:frontend:packaged:sync-rehearsal && npm run test:frontend:packaged:update-rehearsal && npm run test:frontend:packaged:orphan-reclaim-rehearsal && npm run test:frontend:packaged:browser-job-rehearsal && npm run test:frontend:packaged:jobs-pipeline",
    "build:frontend-runtime-config": "npm run check:python-version && python scripts/build_frontend_runtime_config.py",
    "build:ship-bundle": "npm run check:python-version && python scripts/build_ship_bundle.py",
    "build:portable-exe": "npm run check:python-version && python scripts/build_portable_exe.py",
    "test:unit": "npm run test:frontend:unit",
    "test:smoke": "npm run test:frontend",
    "test:frontend:packaged": "npm run check:python-version && python src/packaged_desktop_smoke.py",
    "test:frontend:packaged:sync-rehearsal": "npm run check:python-version && python src/packaged_desktop_smoke.py --sync-rehearsal --rebuild --runtime-timeout 60",
    "test:frontend:packaged:update-rehearsal": "npm run check:python-version && python src/packaged_desktop_smoke.py --desktop-update-rehearsal --rebuild --runtime-timeout 60",
    "test:frontend:packaged:orphan-reclaim-rehearsal": "npm run check:python-version && python src/packaged_desktop_smoke.py --orphan-reclaim-rehearsal --rebuild --runtime-timeout 60",
    "test:frontend:packaged:browser-job-rehearsal": "npm run check:python-version && python src/packaged_desktop_smoke.py --browser-job-rehearsal --rebuild --runtime-timeout 60",
    "test:frontend:packaged:jobs-pipeline": "npm run check:python-version && python src/packaged_desktop_smoke.py --node-smoke-script tests/frontend/packaged-desktop-smoke.jobs-pipeline.mjs --playwright-timeout 300",
    "test:frontend:packaged:orchestrated": "npm run check:python-version && python src/packaged_desktop_smoke.py --exe-path _out/latest/build/portable/Baluffo.exe",
    "test:frontend:packaged:headed": "npm run check:python-version && python src/packaged_desktop_smoke.py --headed --pause-on-failure",
    "probe:desktop:startup:cold": "npm run check:python-version && python src/packaged_desktop_smoke.py --rebuild --startup-probe --profile-only --profile-mode cold --runtime-timeout 60",
    "probe:desktop:startup:pair": "npm run check:python-version && python scripts/run_startup_probe_pair.py --runtime-timeout 60",
    "probe:desktop:startup:warm": "npm run check:python-version && python src/packaged_desktop_smoke.py --rebuild --startup-probe --profile-only --profile-mode warm --runtime-timeout 60",
    "test:frontend": "playwright test --workers=1 --reporter=line",
    "test:frontend:perf": "playwright test --config=playwright.perf.config.js",
    "test:frontend:unit": "node --test --test-reporter=dot \"tests/frontend/unit/*.test.mjs\"",
    "test:frontend:headed": "playwright test --headed",
    "test:frontend:ci": "playwright test --reporter=line",
    "test:py": "npm run check:python-version && python -m pytest tests -q -m \"not slow and not packaging and not release\" --color=no --basetemp=.tmp/pytest/basetemp",
    "test:py:extended": "npm run check:python-version && python -m pytest tests -q --color=no --basetemp=.tmp/pytest/basetemp",
    "test:py:timing": "npm run check:python-version && python -m pytest tests -q --durations=25 --durations-min=0.2 --color=no --basetemp=.tmp/pytest/basetemp",
    "test:py:cov": "npm run check:python-version && python -m pytest tests -q -m \"not slow\" --cov=src --cov-report=term-missing --color=no",
    "perf:py:timing": "npm run test:py:timing",
    "perf:discovery:benchmark": "npm run check:python-version && python src/discovery_sanity_benchmark.py",
    "perf:discovery:quick": "npm run check:python-version && python src/discovery_sanity_benchmark.py --preset quick --timeout 10 --top 5 --output-dir _out/perf-sanity-discovery-quick",
    "perf:ci": "npm run check:python-version && python scripts/perf_ci.py",
    "perf:baseline:record": "npm run check:python-version && python scripts/perf_baseline.py",
    "perf:compare": "npm run check:python-version && python scripts/perf_compare.py",
    "perf:startup:cold": "npm run probe:desktop:startup:cold",
    "perf:startup:pair": "npm run probe:desktop:startup:pair",
    "perf:startup:warm": "npm run probe:desktop:startup:warm",
    "perf:trend": "npm run check:python-version && python scripts/perf_trend.py",
    "lint:py": "ruff check .",
    "format:py": "ruff format .",
    "lint:js": "eslint .",
    "security:python": "python scripts/security_audit.py",
    "lint:deadcode:js": "knip"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.58.2",
    "eslint": "9.39.4",
    "knip": "5.88.1"
  }
}
